						<a href="#estudio" class="button secondary">Material de estudio</a>
						<a href="https://github.com/Medinaosp/e-portafolio" class="button secondary" target="_blank" rel="noreferrer">Código en GitHub ↗</a>
					</div>
				</div>

				<div class="hero-card">
					<div class="avatar">
						<img src="/e-portafolio/foto/foto1.jpeg" alt="Foto de Federico Medina" />
					</div>
					<div class="card-info">
						<p>{programa}</p>
						<h2>{asignatura}</h2>
						<span>Universidad El Bosque · {periodo}</span>
					</div>
				</div>
			</section>

			<section id="presentacion" class="section">
